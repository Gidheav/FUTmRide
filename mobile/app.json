    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.lrride.mobile",
      "config": {
        "googleMapsApiKey": "AIzaSyD5nLbEz_xY6UOHJ1mbjvipD1PY1A14erQ"
      }
    },
    "android": {
      "package": "com.lrride.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/FUT-icon-removedbg.png",
        "backgroundColor": "#5B2D8E"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD5nLbEz_xY6UOHJ1mbjvipD1PY1A14erQ"
        }
      }
    },
    "scheme": "lrride",
    "extra": {
      "eas": {
        "projectId": "f7d791f1-e8c4-4454-a701-5bbfc5c1e80b"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B2D8E",
          "defaultChannel": "ride-status-alerts"
        }
      ]
    ],
    "owner": "heavpro"
  }
}