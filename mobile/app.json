{
  "expo": {
    "name": "FUTMstd",
    "slug": "futmstd",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "runtimeVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/FUT-icon-removedbg.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/FUT-icon-removedbg.png",
      "resizeMode": "contain",
      "backgroundColor": "#d3c5e3"
