{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@student/*": [
        "src/student/*"
      ],
      "@driver/*": [
        "src/driver/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "allowJs": true
  },
  "include": [
    "index.js",
    "app.json",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**"
  ],
  "extends": "./node_modules/expo/tsconfig.base.json"
}
