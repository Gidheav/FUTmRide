{
  "expo": {
    "name": "LR Ride Driver",
    "slug": "lr-ride-driver",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "runtimeVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "checkAutomatically": "OFF"
    },
    "android": {
      "package": "com.lrride.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.lrride.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to connect you with nearby students and update ride tracking."
      }
    },
    "scheme": "lrride-driver"
  }
}
